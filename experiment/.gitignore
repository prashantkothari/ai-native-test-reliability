# Local target repo — cloned separately by anyone reproducing (see PLAN.md for pinned SHA)
target_repo/

# Node deps
node_modules/
package-lock.json

# Derived bundle (rebuild with: node harness/bundle-library.js)
logs/selfheal-bundle.js

# Playwright ephemera
/test-results/
/playwright-report/

# Per-trial screenshots — regenerated on every run, not worth git bloat
logs/screenshots/

# Vendor-scrub sentinel (per vendor-refresh run, not committed — see tools/vendor-scrub.sh)
tools/.vendor-scrubbed

# Playwright trace zips — large, regenerable debugging artifacts, not cited by
# any report/*.md (verified 2026-09-23). *.jsonl logs ARE cited as evidence and
# stay tracked; only traces/ is excluded.
logs/traces/
